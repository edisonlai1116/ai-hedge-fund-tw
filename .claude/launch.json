{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "docs",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8766",
        "--directory",
        "docs"
      ],
      "port": 8766
    },
    {
      "name": "frontend",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8770",
        "--directory",
        "app/frontend/dist"
      ],
      "port": 8770,
      "autoPort": false
    },
    {
      "name": "webapp",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "uvicorn",
        "app.backend.web_app:app",
        "--port",
        "8000"
      ],
      "port": 8000
    }
  ]
}